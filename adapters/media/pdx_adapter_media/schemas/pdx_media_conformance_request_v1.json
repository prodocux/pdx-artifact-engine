{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/media/conformance-request-v1.json",
  "title": "PDX media conformance request v1 (proposal)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "profile", "expected"],
  "properties": {
    "schema_version": {"const": "pdx_media_conformance_request_v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "profile": {"$ref": "https://prodocux.dev/schemas/pdx/media/technical-profile-v2.json"},
    "expected": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "containers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "video_codecs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}, "fps_tolerance": {"type": "number", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0}, "duration_tolerance_seconds": {"type": "number", "minimum": 0},
        "audio": {"enum": ["required", "allowed", "forbidden"]},
        "max_black_frame_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_freeze_duration_seconds": {"type": "number", "minimum": 0},
        "max_silence_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_clipping_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}

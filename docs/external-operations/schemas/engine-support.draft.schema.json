{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pdx:draft:er003:support:2",
  "title": "ER-003 supporting definitions; draft only",
  "$defs": {
    "authority_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority_id",
        "tenant_id",
        "controller_principals",
        "issuer_principals",
        "adapter_principals",
        "manual_principals",
        "administrator_principals",
        "supervisor_principals",
        "reader_principals",
        "revision"
      ],
      "properties": {
        "schema_version": {
          "const": "pdx_er003_authority_config_draft_v2"
        },
        "authority_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "tenant_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "controller_principals": {
          "type": "array",
          "items": {
            "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
          },
          "maxItems": 64
        },
        "issuer_principals": {
          "type": "array",
          "items": {
            "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
          },
          "maxItems": 64
        },
        "adapter_principals": {
          "type": "array",
          "items": {
            "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
          },
          "maxItems": 64
        },
        "manual_principals": {
          "type": "array",
          "items": {
            "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
          },
          "maxItems": 64
        },
        "administrator_principals": {
          "type": "array",
          "items": {
            "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
          },
          "maxItems": 64
        },
        "supervisor_principals": {
          "type": "array",
          "items": {
            "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
          },
          "maxItems": 64
        },
        "reader_principals": {
          "type": "array",
          "items": {
            "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
          },
          "maxItems": 64
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "provider_register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority_id",
        "tenant_id",
        "request_id",
        "idempotency_key",
        "provider_profile_id",
        "revision",
        "account_alias",
        "environment",
        "submit_deployment",
        "query_deployment",
        "execution_policy_digest",
        "lookup_proven",
        "lookup_proof",
        "recovery_mode",
        "endpoint_policy_digest",
        "outcome_mapping_digest",
        "dedupe_retention_seconds",
        "provider_key_format",
        "budgets"
      ],
      "properties": {
        "schema_version": {
          "const": "pdx_er003_provider_register_draft_v2"
        },
        "authority_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "tenant_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "request_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider_profile_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "account_alias": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "environment": {
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "submit_deployment": {
          "$ref": "https://prodocux.dev/schemas/pdx/dynamic-dispatch/common-v1.json#/$defs/deploymentIdentity"
        },
        "query_deployment": {
          "oneOf": [
            {
              "$ref": "https://prodocux.dev/schemas/pdx/dynamic-dispatch/common-v1.json#/$defs/deploymentIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_policy_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "lookup_proven": {
          "type": "boolean"
        },
        "lookup_proof": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verified_artifact",
                "verifier_id",
                "verifier_contract_digest"
              ],
              "properties": {
                "verified_artifact": {
                  "$ref": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/common-v1.json#/$defs/opaqueArtifact"
                },
                "verifier_id": {
                  "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
                },
                "verifier_contract_digest": {
                  "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_mode": {
          "enum": [
            "query_only",
            "manual_only"
          ]
        },
        "endpoint_policy_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "outcome_mapping_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "dedupe_retention_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "provider_key_format": {
          "const": "lowercase_hex_32"
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_query_calls",
            "max_query_execution_seconds",
            "max_scheduling_seconds",
            "max_observations",
            "max_evidence_bytes",
            "max_manual_records_per_case",
            "max_manual_bytes_per_case"
          ],
          "properties": {
            "max_query_calls": {
              "const": 20
            },
            "max_query_execution_seconds": {
              "const": 600
            },
            "max_scheduling_seconds": {
              "const": 86400
            },
            "max_observations": {
              "const": 64
            },
            "max_evidence_bytes": {
              "const": 1048576
            },
            "max_manual_records_per_case": {
              "const": 16
            },
            "max_manual_bytes_per_case": {
              "const": 1048576
            }
          }
        }
      }
    },
    "operation_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_artifact",
        "payload_schema_id",
        "payload_schema_digest",
        "evidence_artifacts",
        "provider_profile_id",
        "provider_profile_revision",

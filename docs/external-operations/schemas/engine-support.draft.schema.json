        },
        "operation_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "operation_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "workflow_job_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "workflow_step_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "plan_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "authorization_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "issuer_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "provider_profile_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "provider_key_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "account_alias": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "environment": {
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "submission_evidence": {
          "enum": [
            "not_started",
            "possibly_submitted",
            "provider_accepted"
          ]
        },
        "provider_outcome": {
          "enum": [
            "unobserved",
            "pending",
            "unknown",
            "confirmed_succeeded",
            "confirmed_failed",
            "confirmed_not_executed"
          ]
        },
        "reconciliation_required": {
          "type": "boolean"
        },
        "subject_reserved": {
          "const": true
        },
        "submit_permits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "resubmission_allowed": {
          "const": false
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "recovery_mode": {
          "enum": [
            "query_only",
            "manual_only"
          ]
        },
        "consumed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query_calls",
            "query_execution_ms",
            "scheduling_elapsed_seconds",
            "observation_records",
            "evidence_bytes"
          ],
          "properties": {
            "query_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "query_execution_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600000
            },
            "scheduling_elapsed_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "observation_records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "evidence_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          }
        },
        "manual_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "records",
              "evidence_bytes"
            ],
            "properties": {
              "case_id": {
                "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
              },

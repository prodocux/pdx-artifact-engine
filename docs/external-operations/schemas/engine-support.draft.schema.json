    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority_id",
        "tenant_id",
        "operation_subject_id",
        "operation_id",
        "operation_digest",
        "workflow_job_id",
        "workflow_step_id",
        "plan_digest",
        "authorization_id",
        "issuer_id",
        "provider_profile_digest",
        "provider_key_digest",
        "account_alias",
        "environment",
        "submission_evidence",
        "provider_outcome",
        "reconciliation_required",
        "subject_reserved",
        "submit_permits",
        "resubmission_allowed",
        "sequence",
        "recovery_mode",
        "consumed",
        "manual_cases",
        "latest_receipt_artifact",
        "parent_terminal_receipt_artifact",
        "conflict_count"
      ],
      "properties": {
        "schema_version": {
          "const": "pdx_er003_projection_draft_v2"

        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_subject_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "specification": {
          "$ref": "urn:pdx:draft:er003:support:2#/$defs/operation_specification"

        "payload_artifact": {
          "$ref": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/common-v1.json#/$defs/opaqueArtifact"
        },
        "payload_schema_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "payload_schema_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "$ref": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/common-v1.json#/$defs/opaqueArtifact"
          },
          "maxItems": 32
        },
        "provider_profile_id": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "provider_profile_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "provider_profile_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "account_alias": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/id"
        },
        "environment": {
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "executor_identity_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        },
        "execution_policy_digest": {
          "$ref": "urn:pdx:draft:er003:core:1#/$defs/digest"
        }
      }
    },
    "subject_register": {
      "type": "object",
      "additionalProperties": false,

          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_operations": {
          "const": 1
        }
      }
    },
    "authorization_revoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority_id",
        "tenant_id",
        "request_id",
        "idempotency_key",
        "authorization_id",
        "issuer_id",
        "revocation_id",

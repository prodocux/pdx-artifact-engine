{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/step-projection-v1.json",
  "title": "PDX runtime provider workflow step projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_job_id", "plan_digest", "workflow_state", "recorded_at", "steps"],
  "properties": {
    "schema_version": {"const": "pdx_runtime_provider_step_projection_v1"},
    "workflow_job_id": {"$ref": "#/$defs/id"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "workflow_state": {"enum": ["pending", "running", "awaiting_tool", "awaiting_approval", "completed", "completed_with_review", "failed", "blocked", "cancelled", "timed_out"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_step_id", "step_kind", "state", "latest_attempt_number", "active_claim", "terminal_record_identity"],
        "properties": {
          "workflow_step_id": {"$ref": "#/$defs/id"},
          "step_kind": {"enum": ["builder", "check", "reviewer", "repair"]},
          "state": {"enum": ["pending", "running", "succeeded", "failed", "cancelled", "timed_out", "unsupported"]},
          "latest_attempt_number": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000},
          "active_claim": {"type": "boolean"},
          "terminal_record_identity": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["record_id", "record_schema_id", "payload_digest"],
                "properties": {
                  "record_id": {"$ref": "#/$defs/id"},
                  "record_schema_id": {"enum": ["pdx_runtime_provider_record_v1", "pdx_runtime_check_record_v1"]},
                  "payload_digest": {"$ref": "#/$defs/digest"}
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"latest_attempt_number": {"type": "null"}}, "required": ["latest_attempt_number"]},
            "then": {
              "properties": {
                "state": {"const": "pending"},
                "active_claim": {"const": false},
                "terminal_record_identity": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"active_claim": {"const": true}}, "required": ["active_claim"]},
            "then": {
              "properties": {
                "state": {"const": "running"},
                "latest_attempt_number": {"type": "integer"},
                "terminal_record_identity": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"terminal_record_identity": {"type": "object"}}, "required": ["terminal_record_identity"]},
            "then": {
              "properties": {
                "state": {"enum": ["succeeded", "failed", "cancelled", "timed_out", "unsupported"]},
                "latest_attempt_number": {"type": "integer"},
                "active_claim": {"const": false}
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/dynamic-dispatch/route-mapping-v1.json",
  "title": "PDX governed dynamic dispatch route mapping v1 draft",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authority", "routes"],
  "properties": {
    "schema_version": {"const": "pdx_dynamic_dispatch_route_mapping_v1"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["principal_source", "request_body_principal_authoritative", "workflow_authority"],
      "properties": {
        "principal_source": {"const": "authenticated_transport"},
        "request_body_principal_authoritative": {"const": false},
        "workflow_authority": {"const": "runtime_provider_workflow"}
      }
    },
    "routes": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation", "method", "path", "request_schema", "success_schema"],
        "properties": {
          "operation": {"enum": ["register_policy", "revoke_policy", "import_external_decision_receipt", "activate", "get_step_projection", "get_dispatch_receipt", "reconcile_dispatch"]},
          "method": {"enum": ["GET", "POST"]},
          "path": {"type": "string", "pattern": "^/internal/v1/runtime-provider-workflows/\\{workflow_job_id\\}/steps/\\{workflow_step_id\\}/dispatch"},
          "request_schema": {"type": ["string", "null"]},
          "success_schema": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

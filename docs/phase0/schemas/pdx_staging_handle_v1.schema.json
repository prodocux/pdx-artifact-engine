{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/phase0/pdx_staging_handle_v1.schema.json",
  "title": "PDX Engine TTL staging handle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "sha256",
    "size_bytes",
    "media_type",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "pdx_staging_handle_v1"},
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^stg_[A-Za-z0-9_-]+$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}

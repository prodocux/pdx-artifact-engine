  "properties": {"schema_version": {"const": "pdx_internal_runtime_provider_claim_request_v1"}, "request_id": {"$ref": "#/$defs/id"}, "correlation_id": {"$ref": "#/$defs/id"}, "worker_id": {"$ref": "#/$defs/id"}, "lease_seconds": {"type": "integer", "minimum": 5, "maximum": 3600}},

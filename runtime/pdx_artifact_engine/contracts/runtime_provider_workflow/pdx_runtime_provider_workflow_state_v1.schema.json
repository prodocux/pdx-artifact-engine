{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/state-v1.json",
  "title": "PDX runtime provider workflow state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_job_id", "task_id", "run_id", "plan_digest", "state", "counters", "updated_at"],
  "properties": {
    "schema_version": {"const": "pdx_runtime_provider_workflow_state_v1"},
    "workflow_job_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "state": {"enum": ["pending", "running", "awaiting_tool", "awaiting_approval", "completed", "completed_with_review", "failed", "blocked", "cancelled", "timed_out"]},
    "counters": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_attempts", "check_attempts", "active_steps", "repair_iterations", "total_runtime_seconds", "total_event_bytes", "total_artifact_bytes", "cross_step_artifact_edges", "external_operations"],
      "properties": {
        "provider_attempts": {"type": "integer", "minimum": 0}, "check_attempts": {"type": "integer", "minimum": 0},
        "active_steps": {"type": "integer", "minimum": 0}, "repair_iterations": {"type": "integer", "minimum": 0}, "total_runtime_seconds": {"type": "integer", "minimum": 0},
        "total_event_bytes": {"type": "integer", "minimum": 0}, "total_artifact_bytes": {"type": "integer", "minimum": 0},
        "cross_step_artifact_edges": {"type": "integer", "minimum": 0}, "external_operations": {"type": "integer", "minimum": 0}
      }
    },
    "terminal_error": {"$ref": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/error-v1.json"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["failed", "blocked", "cancelled", "timed_out"]}}, "required": ["state"]}, "then": {"required": ["terminal_error"], "properties": {"terminal_error": {"$ref": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/error-v1.json"}}}, "else": {"properties": {"terminal_error": false}}}
  ],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

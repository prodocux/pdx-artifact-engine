{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/plan-v1.json",
  "title": "PDX runtime provider workflow plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_job_id", "task_id", "run_id", "plan_digest", "steps", "budgets", "artifact_edges"],
  "properties": {
    "schema_version": {"const": "pdx_runtime_provider_workflow_plan_v1"},
    "workflow_job_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workflow_step_id", "step_kind", "depends_on", "max_attempts"],
        "properties": {
          "workflow_step_id": {"$ref": "#/$defs/id"},
          "step_kind": {"enum": ["builder", "check", "reviewer", "repair"]},
          "depends_on": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 1000},
          "operation_digest": {"$ref": "#/$defs/digest"},
          "check_definition_digest": {"$ref": "#/$defs/digest"},
          "repair_iteration": {"type": "integer", "minimum": 1, "maximum": 1000},
          "parent_step_id": {"$ref": "#/$defs/id"}
        },
        "allOf": [
          {"if": {"properties": {"step_kind": {"const": "check"}}, "required": ["step_kind"]}, "then": {"required": ["check_definition_digest"], "properties": {"check_definition_digest": {"$ref": "#/$defs/digest"}, "operation_digest": false, "repair_iteration": false, "parent_step_id": false}}, "else": {"required": ["operation_digest"], "properties": {"operation_digest": {"$ref": "#/$defs/digest"}, "check_definition_digest": false}}},
          {"if": {"properties": {"step_kind": {"const": "repair"}}, "required": ["step_kind"]}, "then": {"required": ["repair_iteration", "parent_step_id"], "properties": {"repair_iteration": {"type": "integer", "minimum": 1, "maximum": 1000}, "parent_step_id": {"$ref": "#/$defs/id"}}}, "else": {"properties": {"repair_iteration": false, "parent_step_id": false}}}
        ]
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_provider_attempts", "max_check_attempts", "max_concurrent_steps", "max_repair_iterations", "max_total_runtime_seconds", "max_total_event_bytes", "max_total_artifact_bytes", "max_cross_step_artifact_edges", "max_external_operations"],
      "properties": {
        "max_provider_attempts": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_check_attempts": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_concurrent_steps": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_repair_iterations": {"type": "integer", "minimum": 0, "maximum": 1000},
        "max_total_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "max_total_event_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "max_total_artifact_bytes": {"type": "integer", "minimum": 0, "maximum": 107374182400},
        "max_cross_step_artifact_edges": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_external_operations": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "artifact_edges": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["edge_id", "producer_step_id", "consumer_step_id", "artifact_role"],
        "properties": {
          "edge_id": {"$ref": "#/$defs/id"},
          "producer_step_id": {"$ref": "#/$defs/id"},
          "consumer_step_id": {"$ref": "#/$defs/id"},
          "artifact_role": {"enum": ["patch", "check_report", "review", "repair_output", "supporting_evidence"]},
          "producer_attempt_number": {"type": "integer", "minimum": 1, "maximum": 1000}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

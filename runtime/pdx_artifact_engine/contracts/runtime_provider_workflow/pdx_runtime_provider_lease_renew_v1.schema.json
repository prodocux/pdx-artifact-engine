{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://prodocux.dev/schemas/pdx/runtime-provider-workflow/provider-lease-renew-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workflow_job_id", "workflow_step_id", "step_kind", "claim_id", "lease_token", "invocation_id", "attempt_number", "operation_digest", "execution_constraints_digest", "lease_seconds"],
  "properties": {"schema_version": {"const": "pdx_internal_runtime_provider_lease_renew_v1"}, "workflow_job_id": {"$ref": "#/$defs/id"}, "workflow_step_id": {"$ref": "#/$defs/id"}, "step_kind": {"enum": ["builder", "reviewer", "repair"]}, "claim_id": {"$ref": "#/$defs/id"}, "lease_token": {"type": "string", "minLength": 32, "maxLength": 256}, "invocation_id": {"$ref": "#/$defs/id"}, "attempt_number": {"type": "integer", "minimum": 1, "maximum": 1000}, "operation_digest": {"$ref": "#/$defs/digest"}, "execution_constraints_digest": {"$ref": "#/$defs/digest"}, "lease_seconds": {"type": "integer", "minimum": 5, "maximum": 3600}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/dynamic-dispatch/policy-v1.json",
  "title": "PDX governed dynamic dispatch policy v1 draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dispatch_policy_id", "workflow_job_id", "workflow_step_id", "run_a_plan_digest", "decision_step_id", "policy_status", "policy_revision_epoch", "allowed_tool_names", "allowed_tool_names_digest", "allowed_tools", "frozen_tool_definitions_digest", "proposal_limits", "registered_by", "registered_at", "policy_digest"],
  "properties": {
    "schema_version": {"const": "pdx_dynamic_dispatch_policy_v1"},
    "dispatch_policy_id": {"$ref": "common-v1.json#/$defs/id"},
    "workflow_job_id": {"$ref": "common-v1.json#/$defs/id"},
    "workflow_step_id": {"$ref": "common-v1.json#/$defs/id"},
    "run_a_plan_digest": {"$ref": "common-v1.json#/$defs/digest"},
    "decision_step_id": {"$ref": "common-v1.json#/$defs/id"},
    "policy_status": {"enum": ["active", "revoked"]},
    "policy_revision_epoch": {"type": "integer", "minimum": 1},
    "allowed_tool_names": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
    "allowed_tool_names_digest": {"$ref": "common-v1.json#/$defs/digest"},
    "allowed_tools": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "common-v1.json#/$defs/frozenTool"}},
    "frozen_tool_definitions_digest": {"$ref": "common-v1.json#/$defs/digest"},
    "proposal_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_depth", "max_properties_per_object", "max_total_keys", "max_canonical_bytes", "max_secret_refs", "max_array_length"],
      "properties": {
        "max_depth": {"const": 8}, "max_properties_per_object": {"const": 64},
        "max_total_keys": {"const": 256}, "max_canonical_bytes": {"const": 65536},
        "max_secret_refs": {"const": 8}, "max_array_length": {"const": 1024}
      }
    },
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "registered_by": {"$ref": "common-v1.json#/$defs/principal"},
    "registered_at": {"$ref": "common-v1.json#/$defs/timestamp"},
    "policy_digest": {"$ref": "common-v1.json#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"policy_status": {"const": "revoked"}}}, "then": {"required": ["revoked_at"], "properties": {"revoked_at": {"type": "string"}}}},
    {"if": {"properties": {"policy_status": {"const": "active"}}}, "then": {"properties": {"revoked_at": {"type": "null"}}}}
  ]
}

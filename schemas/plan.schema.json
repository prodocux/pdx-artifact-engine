{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/plan.schema.json",
  "title": "PDX Plan",
  "type": "object",
  "required": ["schema_version", "request_id", "intent", "steps", "verification"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pdx_plan_v0"
    },
    "request_id": {
      "type": "string"
    },
    "intent": {
      "type": "object",
      "required": ["artifact_type", "summary"],
      "properties": {
        "artifact_type": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "regulated"]
        }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["expert", "skill", "human_input", "verification", "fixture"]
          },
          "name": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Step ids that must complete before this step runs"
          },
          "inputs": {
            "type": "object"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check"],
        "properties": {
          "id": {
            "type": "string"
          },
          "check": {
            "type": "string",
            "description": "Supported built-ins: step_completed:<id>, file_exists:<relpath>, always_review:<reason>"
          },
          "fail_action": {
            "type": "string",
            "enum": ["repair", "ask_human", "stop"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

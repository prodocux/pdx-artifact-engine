{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/skill.schema.json",
  "title": "PDX Skill Metadata",
  "description": "Canonical metadata for one callable skill. Used both standalone and as entries inside a skill registry.",
  "type": "object",
  "required": [
    "name",
    "version",
    "domain",
    "description",
    "entrypoint",
    "inputs",
    "outputs",
    "failure_codes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string",
      "description": "Shell-invocable command or module form, e.g. python -m package.module"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Logical input roles accepted by the skill"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Logical output roles produced by the skill"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Artifact roles written to disk; defaults to outputs when omitted"
    },
    "failure_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "meaning"],
        "properties": {
          "code": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "verification_hooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_schema": {
      "type": "object",
      "description": "Optional JSON Schema for structured skill inputs"
    },
    "output_schema": {
      "type": "object",
      "description": "Optional JSON Schema for structured skill outputs"
    }
  },
  "additionalProperties": false
}

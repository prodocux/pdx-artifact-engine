{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/run_manifest.schema.json",
  "title": "PDX Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "status",
    "steps",
    "verification",
    "artifact_manifest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pdx_run_manifest_v0"
    },
    "run_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "completed_with_review", "failed", "blocked"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "kind", "name", "status"],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["completed", "mocked", "skipped", "failed", "blocked"]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "status"],
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "review", "fail", "blocked"]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_manifest": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planner": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

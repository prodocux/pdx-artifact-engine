{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/skill_registry.schema.json",
  "title": "PDX Skill Registry",
  "type": "object",
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pdx_skill_registry_v0"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "domain",
          "description",
          "entrypoint",
          "inputs",
          "outputs",
          "failure_codes"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "entrypoint": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "artifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "failure_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["code", "meaning"],
              "properties": {
                "code": { "type": "string" },
                "meaning": { "type": "string" },
                "retryable": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "verification_hooks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

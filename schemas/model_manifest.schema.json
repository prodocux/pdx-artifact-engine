{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/pdx/model_manifest.schema.json",
  "title": "PDX Model Manifest",
  "description": "Describes an optional expert model without embedding weights in the repository.",
  "type": "object",
  "required": [
    "schema_version",
    "model_id",
    "role",
    "display_name",
    "status",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pdx_model_manifest_v0"
    },
    "model_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "core_router",
        "doc_expert",
        "code_expert",
        "data_expert",
        "media_expert",
        "cad_expert",
        "other"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "training", "preview", "released", "deprecated"]
    },
    "base_model": {
      "type": "string"
    },
    "parameter_class": {
      "type": "string",
      "description": "e.g. 1B-class"
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "model_card": {
      "type": "string",
      "description": "Path or URL to model card"
    },
    "ram_mb_estimate": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "uri"],
        "properties": {
          "format": {
            "type": "string",
            "enum": ["gguf", "safetensors", "lora", "other"]
          },
          "uri": {
            "type": "string",
            "description": "Download URI (Hugging Face, GitHub Release, private registry)"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "filename": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "inference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["none", "llama_cpp", "external", "mock"]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
